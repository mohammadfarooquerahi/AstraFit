# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ai-fitness-coach

# JWT Authentication
JWT_SECRET=super_secret_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_token_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI API Providers (OpenAI & Gemini)
# Abstraction layer will pick the one configured here
ACTIVE_AI_PROVIDER=gemini # 'openai' or 'gemini'

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Media/Image Upload Config
# Set to 'local' for local development storage, or 's3' for AWS S3
UPLOAD_PROVIDER=local
UPLOAD_BUCKET=ai-fitness-coach-uploads
UPLOAD_REGION=us-east-1
UPLOAD_ACCESS_KEY=your_aws_access_key
UPLOAD_SECRET_KEY=your_aws_secret_key
